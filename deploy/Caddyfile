{
    acme_ca https://acme-v02.api.letsencrypt.org/directory
}

fluxradar.net {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Creem checkout is a full-page redirect to Creem's own hosted page,
        # never framed or scripted on this page, so it needs no CSP source of
        # its own. Google Analytics 4: gtag.js from exactly
        # www.googletagmanager.com, and hits to Google's
        # regional collection hosts — only once a visitor allows analytics.
        # Sentry error reports go to its EU ingest hosts, and only from a
        # build given a DSN (apps/web/src/error-monitoring.ts): connect-src
        # alone, because the SDK is bundled and served from this origin.
        # No wildcard script source, no inline script, no frame source at all,
        # and `frame-ancestors 'none'` still forbids framing FluxRadar.
        Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self' data:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://*.ingest.de.sentry.io; frame-src 'none'"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    # Plausible Analytics, proxied through this origin as a first-party request.
    #
    # The browser asks this site for /js/script.js and posts events to
    # /js/event; both are forwarded to plausible.io. Nothing here is a
    # third-party request, which is why the Content-Security-Policy above needs
    # no Plausible source at all: `script-src 'self'` covers the tracker and
    # `connect-src 'self'` covers its events. It also puts the script outside
    # the blocklists that match on Plausible's own hostname, which is the point
    # of https://plausible.io/docs/proxy/guides/caddy.
    #
    # `pa-XXXXX.js` is the site's own script, named in Site Installation under
    # General in the Plausible site settings. The id lives in
    # apps/web/src/plausible-config.ts, which is the source of truth; DEPLOY-023
    # checks that the script rewrite below still agrees with it.
    #
    # The event path has two halves and needs both of them. Plausible accepts
    # events at /api/event and only there: https://plausible.io/js/event is a
    # 404. This site cannot offer /api/event as its own public path either,
    # because /api/* below is our API, and Caddy orders a named matcher by where
    # it sits in the file rather than by how specific it is — an /api/event of
    # ours would depend on this block staying above that one, while /js/event
    # cannot collide with it at all. So the public path is /js/event and the
    # second rewrite below turns it into the /api/event the upstream answers.
    # Dropping that rewrite posts every event to a 404, and a lost event looks
    # exactly like a quiet site, so nothing would ever report it. This block is
    # kept first regardless, and DEPLOY-023 pins both rewrites.
    #
    # X-Forwarded-For carries the visitor's address. Plausible silently drops an
    # event whose forwarded address is missing or is the proxy's own, and
    # answers 202 either way, so a wrong value here would be invisible
    # (https://plausible.io/docs/proxy/introduction).
    #
    # Caddy terminates TLS directly and no trusted_proxies is set, so the
    # connecting peer IS the visitor — the same fact the log block below relies
    # on — and `reverse_proxy` already sends that address while ignoring any
    # X-Forwarded-For the client supplied. Caddy therefore warns this line is
    # unnecessary, and today it is: it is kept because it states the one header
    # Plausible needs, and because it pins the value to the peer if a
    # trusted_proxies is ever added, which would otherwise make a client-sent
    # X-Forwarded-For authoritative and let anyone forge the visitor's country.
    @plausible path /js/script.js /js/event
    handle @plausible {
        rewrite /js/script.js /js/pa-RdP8FeGFozbbu7f5BnXd1.js
        rewrite /js/event /api/event
        reverse_proxy https://plausible.io {
            header_up Host {http.reverse_proxy.upstream.hostport}
            header_up X-Forwarded-For {http.request.remote.host}
        }
    }

    handle_path /api/* {
        reverse_proxy {$FLUXRADAR_API_UPSTREAM}
    }

    handle {
        reverse_proxy {$FLUXRADAR_WEB_UPSTREAM}
    }

    # Access log: the honest, cookieless count of traffic. GA4 sees only the
    # visitors who accept analytics cookies and never sees a crawler, so this
    # file is where page hits, referrers and the AI bots (GPTBot, ClaudeBot,
    # PerplexityBot...) show up. scripts/traffic-report.sh turns it into a
    # GoAccess report; the filtering and retention it relies on are below.
    #
    # No line identifies a person or opens an account:
    #   - IPs are cut to their /24 (IPv4) or /48 (IPv6) network before a line
    #     is written. The DNS record is not proxied, so there are no trusted
    #     proxies and client_ip equals remote_ip; both are masked anyway.
    #   - One-time secrets travel as query parameters: the mailed reset and
    #     verification links (?reset_token=, ?verify_email=), the API call that
    #     spends one (?token=), OAuth's callback (?code=, ?state=), and the
    #     Creem return page, which the hosted checkout sends the buyer back to
    #     with the checkout, order and customer ids and Creem's signature over
    #     them (?checkout_id=, ?order_id=, ?signature=...). Those keys are
    #     deleted from the URI. The Referer carries the whole same-origin URL
    #     and a redirect's Location can carry OAuth state, so both lose their
    #     query string entirely.
    #   - Credentials and client-supplied forwarding headers (which can carry
    #     an unmasked address) are deleted, not left as Caddy's REDACTED.
    #
    # The Privacy Policy keeps ordinary logs for at most 30 days. Caddy 2.10
    # rolls by size, not by time: an entry waits in the live file until it
    # fills, and the rolled file is deleted by the first roll or restart after
    # it turns 14 days old. Small files keep that sum well inside 30 days;
    # DEPLOY-018 pins the numbers and checks that sum.
    log {
        output file /data/logs/access.log {
            roll_size 2MiB
            roll_keep 100
            roll_keep_for 336h
        }
        format filter {
            wrap json
            request>remote_ip ip_mask {
                ipv4 24
                ipv6 48
            }
            request>client_ip ip_mask {
                ipv4 24
                ipv6 48
            }
            request>uri query {
                delete reset_token
                delete verify_email
                delete token
                delete code
                delete state
                delete email
                # The Creem return page (/checkout/return). A payment is
                # confirmed by the signed webhook, never by these, but an order
                # id and Creem's signature over it must not sit in a log for
                # two weeks. One line per key in billing/creem/return-url.ts;
                # DEPLOY-018 checks the two lists agree.
                delete checkout_id
                delete order_id
                delete customer_id
                delete subscription_id
                delete product_id
                delete request_id
                delete signature
            }
            request>headers>Referer regexp "[?].*" ""
            resp_headers>Location regexp "[?].*" ""
            request>headers>Cookie delete
            request>headers>Authorization delete
            request>headers>Proxy-Authorization delete
            request>headers>Forwarded delete
            request>headers>X-Forwarded-For delete
            request>headers>X-Real-Ip delete
            resp_headers>Set-Cookie delete
        }
    }
}
