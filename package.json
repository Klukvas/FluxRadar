{
  "name": "fluxradar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:backend": "eslint . --ignore-pattern \"apps/web/**\" --ignore-pattern \"e2e/**\"",
    "lint:frontend": "eslint apps/web e2e",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm -r --parallel dev",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/client",
      "@prisma/engines"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-ggr8-5vv4-36mx"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
