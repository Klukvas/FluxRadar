{
  "name": "@fluxradar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && RUST_LOG=info prisma migrate deploy && node --env-file-if-exists=../../.env --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "RUST_LOG=info prisma migrate deploy",
    "db:push": "RUST_LOG=info prisma migrate deploy",
    "test": "NODE_ENV=test prisma generate && NODE_ENV=test node ../../node_modules/vitest/vitest.mjs run",
    "test:unit": "NODE_ENV=test prisma generate && NODE_ENV=test node ../../node_modules/vitest/vitest.mjs run --config vitest.unit.config.ts",
    "test:db": "NODE_ENV=test prisma generate && NODE_ENV=test node ../../node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1126.0",
    "@fluxradar/ai": "workspace:*",
    "@fluxradar/contracts": "workspace:*",
    "@fluxradar/crawler": "workspace:*",
    "@fluxradar/export": "workspace:*",
    "@fluxradar/fingerprint": "workspace:*",
    "@fluxradar/rules": "workspace:*",
    "@fluxradar/safe-fetch": "workspace:*",
    "@fluxradar/scoring": "workspace:*",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "dejavu-fonts-ttf": "^2.37.3",
    "express": "^5.1.0",
    "fontkit": "2.0.4",
    "node-html-parser": "^7.0.1",
    "pdfkit": "^0.20.2",
    "playwright": "^1.63.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/fontkit": "^2.0.9",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.19.3",
    "supertest": "^7.1.0"
  }
}
