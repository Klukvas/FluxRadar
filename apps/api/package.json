{
  "name": "@fluxradar/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && RUST_LOG=info prisma db push && node --watch src/index.ts",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "RUST_LOG=info prisma db push",
    "test": "prisma generate && vitest run",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@fluxradar/contracts": "workspace:*",
    "@prisma/client": "^6.19.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
