// FluxRadar v0.1 database schema (T-06, D-011: PostgreSQL for local, test, and production).
// Status columns are strings holding the canonical contract enum literals from
// @fluxradar/contracts; keeping the literals as text makes the export contract
// explicit and provider-independent (D-108).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  emailVerifiedAt       DateTime?
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?
  // One-time anonymous-quality gate: the Free check is granted once per account.
  // The nullable timestamp is claimed atomically before the scan/job is created.
  freeCheckUsedAt       DateTime?
  createdAt             DateTime  @default(now())

  sessions           Session[]
  siteProfiles       SiteProfile[]
  purchases          Purchase[]
  checkoutSessions   CheckoutSession[]
  scans              Scan[]
  aiConsents         AiConsent[]
  integrations       IntegrationConnection[]
  googleBindings     SiteGoogleBinding[]
  bingBindings       SiteBingBinding[]
  oauthStates        IntegrationOAuthState[]
  artifacts          ExportArtifact[]
  emailTokens        EmailToken[]
  emailNotifications EmailNotification[]
  actionPlanLog      ActionPlanAttempt[]
  scanCheckpoints    ScanCheckpoint[]
  crawlPages         ScanCrawlPage[]
  crawlResourceSets  ScanCrawlResourceSet[]
  domainVerifications DomainVerification[]
}

model EmailToken {
  id        String    @id @default(cuid())
  accountId String
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, kind])
  @@index([expiresAt])
}

model EmailNotification {
  id        String   @id @default(cuid())
  accountId String
  eventKey  String   @unique
  kind      String
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
}

// Global anti-abuse claim. It deliberately has no account relation so deleting
// an account does not make its domain eligible for another free check.
model FreeCheckClaim {
  origin    String   @id
  claimedAt DateTime @default(now())
}

// Content-free audit fact that survives account deletion (§17 retention).
model AccountDeletionAudit {
  id            String    @id @default(cuid())
  accountIdHash String    @unique
  status        String
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?
}

// Allows old signed evidence links to fail closed with 410 after retention.
model DeletedScan {
  id            String   @id @default(cuid())
  scanId        String   @unique
  accountIdHash String
  reason        String
  deletedAt     DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  accountId String
  tokenHash String   @unique
  expiresAt DateTime

  account Account @relation(fields: [accountId], references: [id])
}

model SiteProfile {
  id        String   @id @default(cuid())
  accountId String
  name      String
  domain    String
  industry  String?
  region    String?
  language  String?
  businessDescription String?
  offerings           String?
  targetLanguages     String?
  targetAudience      String?
  scanConfigJson      String    @default("{\"plan\":\"Complete\",\"scope\":{\"includeSubdomains\":false,\"maxPages\":15,\"maxDepth\":5,\"queryPolicy\":\"ignore\",\"respectRobots\":true,\"robotsOverrideConfirmed\":false,\"userAgent\":\"desktop\"}}")
  scanConfigVersion   Int       @default(1)
  createdAt DateTime @default(now())

  account          Account            @relation(fields: [accountId], references: [id])
  purchases        Purchase[]
  checkoutSessions CheckoutSession[]
  scans            Scan[]
  googleBinding    SiteGoogleBinding?
  bingBinding      SiteBingBinding?
  domainVerification DomainVerification?

  // T-12: one profile per (account, domain) — a second profile for the same
  // origin would split scan history and break Resolved/Reopened comparison.
  @@unique([accountId, domain])
}

// Idempotency contract §18: (provider, providerTransactionId) admits exactly one
// purchase. The pair — not the id alone — is the key, so a FastSpring order id can
// never be mistaken for a legacy MockPaddle transaction id (and vice versa).
model Purchase {
  id                    String   @id @default(cuid())
  accountId             String
  siteProfileId         String
  plan                  String
  /**
   * Payment provider that produced this purchase: 'fastspring' | 'paddle' (legacy).
   * The default exists so the previous release, which does not know this column,
   * can still insert during an expand-phase rollout. New code always sets it.
   */
  provider              String   @default("paddle")
  /**
   * FastSpring order id, or the legacy MockPaddle transaction id.
   */
  providerTransactionId String
  /**
   * EXPAND-PHASE COMPATIBILITY. The previous release still reads this column, so
   * a database trigger mirrors providerTransactionId into it (and back) and it is
   * never actually null. Application code must not read or write it; the contract
   * migration drops it. See migrations/20260906180000_.../migration.sql.
   */
  paddleTransactionId   String?  @unique
  /**
   * FastSpring product path, or the legacy MockPaddle price id.
   */
  priceId               String?
  /**
   * USD-normalised price the refund policy works in.
   */
  amountUsd             Float
  currency              String
  /**
   * What the buyer was actually charged when FastSpring localised the currency.
   * Null when the charge was already in USD.
   */
  settledAmount         Float?
  settledCurrency       String?
  // Billing state: 'paid' | 'Refunded' | 'Disputed' (§18: billing overlay, not a scan state).
  status                String   @default("paid")
  createdAt             DateTime @default(now())

  account     Account          @relation(fields: [accountId], references: [id])
  siteProfile SiteProfile      @relation(fields: [siteProfileId], references: [id])
  entitlement Entitlement?
  scan        Scan?
  refund      RefundRecord?
  refundLines ProviderRefund[]
  checkout    CheckoutSession?

  @@unique([provider, providerTransactionId])
  /// Profile deletion counts the purchases that block it; the SiteProfile
  /// foreign key is checked on every profile write.
  @@index([siteProfileId])
}

// Server-side binding between a paid checkout and the account/profile it was
// started for. It is created BEFORE the provider session is opened and is the
// only source of truth for accountId/siteProfileId/plan/scope/AI consent — the
// browser and the provider payload never supply them. `reference` is the opaque
// value round-tripped through FastSpring order tags and item attributes.
model CheckoutSession {
  id                String    @id @default(cuid())
  provider          String
  reference         String    @unique
  accountId         String
  siteProfileId     String
  plan              String
  /**
   * Provider product identifier the session was opened with (FastSpring product path).
   */
  productPath       String
  /**
   * Catalogue price in USD at session time; kept for reconciliation.
   */
  expectedAmountUsd Float
  /**
   * Amount/currency FastSpring itself quoted for the session, when it returns one.
   */
  quotedAmount      Float?
  quotedCurrency    String?
  /**
   * True for a live-mode checkout, false for a provider test-mode checkout.
   */
  liveMode          Boolean
  providerSessionId String?
  /**
   * 'created' | 'completed' | 'rejected'.
   */
  status            String    @default("created")
  statusReason      String?
  /**
   * What the buyer was actually charged, echoed from the completed order.
   */
  settledAmount     Float?
  settledCurrency   String?
  scopeJson         String
  profileConfigVersion Int @default(1)
  executionConfigJson String?
  aiConsentJson     String?
  purchaseId        String?   @unique
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Cascade, not Prisma's RESTRICT default: the previous release does not know
  // this table, so its account deletion removes SiteProfile/Account without
  // clearing checkout sessions first. RESTRICT would make that deletion fail
  // after a rollback. The current release still deletes them explicitly.
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  siteProfile SiteProfile @relation(fields: [siteProfileId], references: [id], onDelete: Cascade)
  // The purchase outlives the session: keep the paid record when it is removed.
  purchase    Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([provider, providerSessionId])
  /// "Does this profile have a checkout that can still be paid?" — asked before
  /// a profile is deleted and before its domain may be changed.
  @@index([siteProfileId, status])
}

// Unique purchaseId: exactly one entitlement per purchase (§18 idempotency contract).
model Entitlement {
  id         String   @id @default(cuid())
  purchaseId String   @unique
  expiresAt  DateTime
  suspended  Boolean  @default(false)

  purchase Purchase @relation(fields: [purchaseId], references: [id])
}

// purchaseId is nullable-unique: the Free check runs without a purchase,
// every paid purchase owns exactly one scan (§18 idempotency contract).
model Scan {
  id                     String    @id @default(cuid())
  purchaseId             String?   @unique
  accountId              String
  siteProfileId          String
  plan                   String
  domain                 String
  status                 String    @default("Pending")
  statusReason           String?
  scopeJson              String
  profileConfigVersion   Int       @default(1)
  executionConfigJson    String?
  rulesetVersion         String
  platformRetryCount     Int       @default(0)
  moduleRetryCount       Int       @default(0)
  /// Set when the owner asks the run to stop. The worker reads it between
  /// bounded steps, which is what makes "paused" mean "no new outbound work"
  /// rather than "the status column changed".
  pauseRequestedAt       DateTime?
  /// How much of the site this run has actually read. Module counts answer
  /// "which sections are done"; these answer "how far through my site is it".
  scannedUrlCount        Int       @default(0)
  discoveredUrlCount     Int       @default(0)
  // Action Plan spend counters for the CURRENT snapshot (D-232). Re-running the
  // scan clears the plans and resets all five: the snapshot they were written
  // from no longer exists.
  //
  // actionPlanRunAttemptId is the fence, not the timestamp: it identifies the
  // one attempt that owns the slot, so a superseded run finishing late can never
  // match a newer claim no matter how close together the two started.
  actionPlanAttempts     Int       @default(0)
  actionPlanSuccesses    Int       @default(0)
  actionPlanRunStartedAt DateTime?
  actionPlanRunAttemptId String?
  actionPlanRunLanguage  String?
  startedAt              DateTime?
  completedAt            DateTime?
  createdAt              DateTime  @default(now())

  purchase             Purchase?             @relation(fields: [purchaseId], references: [id])
  account              Account               @relation(fields: [accountId], references: [id])
  siteProfile          SiteProfile           @relation(fields: [siteProfileId], references: [id])
  modules              ScanModule[]
  issues               Issue[]
  coverageProofs       RuleCoverageProof[]
  aiResponses          AiResponseRecord[]
  aiConsent            AiConsent?
  job                  Job?
  artifacts            ExportArtifact[]
  actionPlans          ActionPlan[]
  actionPlanLog        ActionPlanAttempt[]
  checkpoint           ScanCheckpoint?
  crawlPages           ScanCrawlPage[]
  crawlResourceSet     ScanCrawlResourceSet?

  /// Scan history is read one page at a time, newest first, for one account —
  /// with and without a site-profile filter. Both list endpoints order by
  /// (createdAt DESC, id DESC), so these two indexes are the ordering as much as
  /// the filter: PostgreSQL walks them backwards and stops at the page size
  /// instead of sorting every scan the account has ever run.
  @@index([accountId, createdAt, id])
  @@index([accountId, siteProfileId, createdAt, id])
  /// The Basic/Complete history gate asks "does this account (or this profile)
  /// own a scan of plan X" before every list page. It is an existence probe and
  /// must not have to read rows to answer it.
  @@index([accountId, plan])
  /// GET /scans/active: the one in-flight scan of an account.
  @@index([accountId, status])
  /// Profile deletion counts the scans that block it, and the SiteProfile
  /// foreign key is checked on every profile write.
  @@index([siteProfileId])
}

// Where a paused run got to, so resuming it continues the scan the owner
// already paid for instead of starting a second one.
//
// It is a bounded index, never a copy of the crawl: the frontier and the visited
// URLs are capped by SCAN_CHECKPOINT_LIMITS and page bodies are deliberately
// absent, which keeps one row per paused scan affordable. Everything already
// finished — module rows, issues, AI responses — stays where it is; this row
// only records WHICH stages those were, so a resumed attempt does not re-run
// (and re-charge for) work that completed.
model ScanCheckpoint {
  id            String   @id @default(cuid())
  scanId        String   @unique
  /// Denormalized so account deletion and the retention sweep can reach these
  /// rows without joining through the scan they belong to.
  accountId     String
  schemaVersion Int      @default(1)
  /// The stage the run stopped in: 'crawl' or a module name.
  stage         String
  payloadJson   String
  sizeBytes     Int
  /// A checkpoint nobody resumed is swept like any other stale artifact.
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Cascade for the same reason as CheckoutSession: the previous release does
  // not know this table, so a rollback's account deletion would fail on a
  // RESTRICT foreign key. The current release still deletes these rows itself.
  scan    Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

// The pages a paused run already read, kept so resuming is not a re-crawl.
//
// This is the expensive half of a pause, and every bound on it
// (SCAN_EVIDENCE_LIMITS) exists for that reason: a capped number of pages, a
// capped compressed size each, a capped total, and a TTL. A page that does not
// fit is not stored — and its URL goes back on the frontier, so the resumed
// scan re-reads it rather than reporting a page whose evidence is gone.
model ScanCrawlPage {
  id            String   @id @default(cuid())
  scanId        String
  /// Denormalized like ScanCheckpoint.accountId, for deletion and the sweep.
  accountId     String
  normalizedUrl String
  /// Position in the crawl. A batched insert gives every row the same
  /// `createdAt`, so without this the restored order is whatever the database
  /// happens to return.
  ordinal       Int      @default(0)
  /// gzip of the page snapshot as JSON. Bytes, because a site's worth of HTML
  /// in a text column is the one thing this table must not become.
  payload       Bytes
  sizeBytes     Int
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  scan    Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  /// One row per URL per scan: resuming twice must not double the evidence.
  @@unique([scanId, normalizedUrl])
  @@index([accountId])
  @@index([expiresAt])
}

/// The media probes of a paused scan.
///
/// Probing the media a site references costs up to MEDIA_PROBE_LIMITS.maxProbes
/// requests to the owner's server. Without this the whole set was re-issued on
/// every resume, including a resume whose pages were all restored and whose
/// frontier was empty — the same few hundred requests for an answer already
/// known. One row per scan: the set is small, bounded and only useful whole.
model ScanCrawlResourceSet {
  id        String   @id @default(cuid())
  scanId    String   @unique
  /// Denormalized like ScanCrawlPage.accountId, for deletion and the sweep.
  accountId String
  /// gzip of the ResourceSnapshot array as JSON, bounded by SCAN_EVIDENCE_LIMITS.
  payload   Bytes
  sizeBytes Int
  count     Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  scan    Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
}

// Optional proof that an account controls the site it is auditing.
//
// Nothing in the audit pipeline reads this: public pages stay auditable without
// it and no tariff depends on it (docs/CUSTOMER_READINESS_TASKS.md keeps the
// gating decision with the owner). One row per site profile, because the proof
// is about a domain and a profile is how an account names one.
model DomainVerification {
  id                String    @id @default(cuid())
  accountId         String
  siteProfileId     String    @unique
  /// The origin the token was issued for. A profile moved to another domain
  /// invalidates its proof, and this is what makes that detectable.
  domain            String
  method            String
  /// Random, per (account, profile). It is a lookup value published by the
  /// site owner, never a credential for FluxRadar.
  token             String
  status            String    @default("pending")
  issuedAt          DateTime  @default(now())
  tokenExpiresAt    DateTime
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  /// Why the last check did not find the token; operator-safe text only.
  lastFailureReason String?
  attempts          Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  siteProfile SiteProfile @relation(fields: [siteProfileId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model ScanModule {
  id                        String  @id @default(cuid())
  scanId                    String
  module                    String
  runtimeStatus             String
  exportStatus              String?
  statusReason              String?
  coverage                  Float?
  score                     Float?
  applicableChecks          Int?
  completedApplicableChecks Int?
  metadataJson              String  @default("{}")
  // §18 usable output: >=1 completed applicable check AND a valid metric/score/
  // finding with evidence (computed via @fluxradar/scoring hasUsableOutput, D-026).
  usableOutput              Boolean @default(false)

  scan Scan @relation(fields: [scanId], references: [id])

  @@unique([scanId, module])
}

model Issue {
  id                  String   @id @default(cuid())
  scanId              String
  ruleId              String
  module              String
  fingerprint         String
  severity            String
  /// Urgency order of `severity` (0 Critical … 3 Low, 4 unknown). Text sorts
  /// alphabetically and put Low above Medium; lists order by this instead.
  severityRank        Int      @default(4)
  category            String
  status              String
  targetKind          String
  normalizedUrl       String
  normalizedResource  String
  normalizedSelector  String
  normalizedParameter String
  ruleVariant         String
  targetUrl           String
  evidenceType        String
  evidenceRef         String?
  evidenceExcerpt     String?
  // Non-scoring cross-module evidence link (§14 cross-module policy, D-167).
  evidenceGroupId     String?
  recommendation      String
  // Message codes and values behind evidenceExcerpt/recommendation, rendered per
  // report language. NULL for findings that predate codes or carry AI-written text.
  messagesJson        String?
  confidence          Float
  applicableTargets   Int
  affectedTargets     Int
  rulePenalty         Float
  scoreDelta          Float
  observedAt          DateTime

  scan Scan @relation(fields: [scanId], references: [id])

  @@index([scanId, fingerprint])
  @@index([scanId, severityRank, fingerprint])
  @@index([fingerprint])
}

// Доказательство повторной проверки одного модуля (§14): что каждое его
// правило прочитало, о чём спрашивало и на каком материале держится каждая его
// находка. Читает его ТОЛЬКО политика Resolved следующего Complete-скана
// (apps/api/src/orchestrator/run-coverage.ts), поэтому оно живёт отдельно от
// ScanModule.metadataJson, который грузится на каждом обращении к скану —
// /scans, /scans/active, дашборд, поллинг статуса.
//
// Пишется в одной транзакции со строкой модуля и его issues, поэтому у скана
// не бывает findings без доказательства и наоборот. Содержимое — gzip(JSON)
// (формат и границы размера — там же, в run-coverage.ts).
model RuleCoverageProof {
  id        String   @id @default(cuid())
  scanId    String
  module    String
  proof     Bytes
  createdAt DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id])

  @@unique([scanId, module])
}

// Normalized provider response (§5/§16); aiRequestKey is the deterministic
// idempotency key ai:{scan_id}:{provider}:{prompt_hash}:{sequence} (D-015).
model AiResponseRecord {
  id                  String   @id @default(cuid())
  scanId              String
  module              String   @default("AI SEO / GEO")
  promptText          String   @default("")
  tokenizerVersion    String?
  provider            String
  apiVersion          String
  modelId             String
  promptVersion       String
  requestId           String
  requestIdSource     String
  aiRequestKey        String   @unique
  usageJson           String
  usageSource         String
  rawText             String
  citationsJson       String
  finishReason        String
  deletionEvidenceRef String?
  createdAt           DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id])
}

// A written Action Plan (D-232). Only READY content lives here, so a running or
// failed regeneration can never hide or lose the plan the owner already has.
// It is not a canonical record: it never reaches JSON/CSV export, and it is
// deleted with its scan.
model ActionPlan {
  id            String   @id @default(cuid())
  scanId        String
  language      String
  contentJson   String
  promptText    String
  promptVersion String
  modelId       String
  requestId     String
  usageJson     String
  /// The Action Plan click notice the owner accepted, not the purchase notice.
  noticeVersion String
  /// Always written explicitly by the one upsert that stores a plan, so the
  /// column carries no database default.
  generatedAt   DateTime

  // Cascade for the same reason as CheckoutSession: a release that predates this
  // table deletes a scan without clearing its plans, and RESTRICT would turn
  // account deletion and retention into a failure after a rollback. The current
  // release still deletes them explicitly (data-retention.ts).
  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, language])
}

// The spend log behind the Action Plan limits. It keeps failed attempts too —
// they cost provider time — and stores a failure CODE, never provider text.
//
// Re-running the scan does NOT delete these rows: the money was spent whatever
// the snapshot now says. They are marked cleared instead, which is what keeps
// them out of the report while they still count against the daily and hourly
// caps.
//
// DELETING the scan does not delete them either, which is why `scanId` is
// nullable and the foreign key is SET NULL rather than Cascade. Deleting a site
// profile deletes its scans and is something a customer may do at any moment;
// taking the log with them would make it a way to clear the account's hourly
// counter and the product's daily one. The detached row keeps no description of
// the scan — the language, the outcome and what it cost — and retention removes
// it once it is older than the widest counting window
// (`purgeDetachedActionPlanAttempts`).
//
// `accountId` is nullable and SET NULL for the same reason read the other way:
// an erased account must not leave its id behind in a log nobody can reach it
// through. The deletion path removes these rows explicitly first
// (data-retention.ts), so the foreign key is the floor, not the mechanism.
model ActionPlanAttempt {
  id            String    @id @default(cuid())
  scanId        String?
  accountId     String?
  language      String
  status        String
  failureCode   String?
  usageJson     String?
  /// The Action Plan click notice this attempt was started under. NULL on rows
  /// written before the column existed — not recorded, not "no notice shown".
  noticeVersion String?
  createdAt     DateTime  @default(now())
  finishedAt    DateTime?
  clearedAt     DateTime?

  scan    Scan?    @relation(fields: [scanId], references: [id], onDelete: SetNull)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  /// The product-wide daily cap counts rows by time, across every scan.
  @@index([createdAt])
  /// The per-account hourly cap counts one account's rows, under the spend lock.
  @@index([accountId, createdAt])
  @@index([scanId])
}

model AiConsent {
  id            String   @id @default(cuid())
  accountId     String
  scanId        String   @unique
  providersJson String
  noticeVersion String
  createdAt     DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
  scan    Scan    @relation(fields: [scanId], references: [id])
}

// User-authorized external data sources. Access and refresh tokens are always
// encrypted before persistence; metadata contains only provider resource IDs
// and selected settings, never raw credentials.
model IntegrationConnection {
  id                    String    @id @default(cuid())
  accountId             String
  provider              String
  status                String    @default("connected")
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopesJson            String    @default("[]")
  metadataJson          String    @default("{}")
  lastCheckedAt         DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, provider])
  @@index([accountId, status])
}

// Which Google properties an account chose for one of its site profiles. Only
// provider resource identifiers are stored here — never tokens, never metrics.
// One binding per site profile keeps a report's data source unambiguous.
model SiteGoogleBinding {
  id                   String   @id @default(cuid())
  accountId            String
  siteProfileId        String   @unique
  /**
   * Search Console property, e.g. "sc-domain:example.com" or "https://example.com/".
   */
  searchConsoleSiteUrl String?
  /**
   * Bare GA4 numeric property id, without the "properties/" prefix.
   */
  ga4PropertyId        String?
  /**
   * Display name captured at selection time so the report can name the source.
   */
  ga4PropertyName      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  account     Account     @relation(fields: [accountId], references: [id])
  siteProfile SiteProfile @relation(fields: [siteProfileId], references: [id])

  @@index([accountId])
}

// Which Bing Webmaster Tools site an account chose for one of its site profiles.
//
// Deliberately a table of its own rather than two more columns on
// SiteGoogleBinding: the two providers are separate grants over separate data,
// and a report has to be able to say "Bing has no property selected" while
// Search Console does. Only the provider's own site URL is stored — never a
// token, never a metric.
model SiteBingBinding {
  id            String   @id @default(cuid())
  accountId     String
  siteProfileId String   @unique
  /**
   * The site exactly as Bing's GetUserSites reported it (e.g. "https://example.com/").
   * Bing matches on the string it gave out, so it is never normalised here.
   */
  siteUrl       String?
  /**
   * Whether Bing said the site was verified at the moment it was chosen. A site
   * can lose verification later, which the scan-time read reports for itself;
   * this is what the owner was shown when they picked it.
   */
  verifiedAtSelection Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // CASCADE, not the default RESTRICT: this row is a pointer at a provider
  // resource, not a record anyone is owed. A RESTRICT here would make a binding
  // able to block the deletion of the account or the site profile it belongs to —
  // i.e. one optional integration could refuse a GDPR erasure — and the failure
  // would appear as an opaque foreign-key error in the middle of a transaction.
  // The deletion paths also remove it explicitly (data-retention.ts,
  // profiles/profile-deletion.ts); the cascade is what makes a path that forgets
  // to safe rather than broken.
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  siteProfile SiteProfile @relation(fields: [siteProfileId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

// One-time OAuth state prevents callback CSRF and replay. Only a SHA-256 hash
// of the state value is stored; the raw value exists in the browser redirect.
model IntegrationOAuthState {
  id        String    @id @default(cuid())
  accountId String
  provider  String
  stateHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, provider])
  @@index([expiresAt])
}

// Private report artifact stored in Hetzner Object Storage. The DB row keeps
// the object address and tenant boundary; the object itself is never public.
model ExportArtifact {
  id          String   @id @default(cuid())
  accountId   String
  scanId      String
  format      String
  objectKey   String
  contentType String
  createdAt   DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
  scan    Scan    @relation(fields: [scanId], references: [id])

  @@unique([scanId, format])
  @@index([accountId, createdAt])
}

// Dedup table for provider webhook events: unique (provider, providerEventId)
// makes redelivery a no-op (§18). FastSpring reuses the event id on automatic
// retries, so the pair is the idempotency key. Raw payload + signature are
// retained per D-029.
model WebhookEvent {
  id                    String   @id @default(cuid())
  provider              String   @default("paddle")
  providerEventId       String
  accountId             String?
  providerTransactionId String?
  /**
   * EXPAND-PHASE COMPATIBILITY, kept readable for the previous release and filled
   * by a database trigger. Application code must not read or write these two; the
   * contract migration drops them.
   */
  paddleEventId         String?  @unique
  paddleTransactionId   String?
  eventType             String
  /**
   * 'processed' | 'deduplicated' | 'ignored' | 'rejected' | 'unlinked' — why the
   * event did or did not act. The default keeps the previous release's inserts,
   * which only ever stored processed events, meaningful.
   */
  outcome               String   @default("processed")
  outcomeReason         String?
  rawBody               String
  signature             String
  processedAt           DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([accountId])
  @@index([providerTransactionId])
  @@index([paddleTransactionId])
  /// The pending-refund sweep's access path: it walks the `unlinked` rows of one
  /// provider in delivery order every five minutes. Without this index that walk
  /// is a sequential scan of every webhook delivery ever received, which grows
  /// with sales volume while the pending rows it is looking for do not.
  @@index([provider, outcome, processedAt])
}

// Unique purchaseId AND unique idempotencyKey (refund:{purchase_id}): a second
// refund is impossible regardless of reason code (§18 idempotency contract).
model RefundRecord {
  id                    String    @id @default(cuid())
  purchaseId            String    @unique
  idempotencyKey        String    @unique
  reasonCode            String
  // 'requested' | 'processing' | 'paid' | 'failed' (§18).
  status                String
  amountUsd             Float
  currency              String?
  taxAmountUsd          Float?
  provider              String    @default("paddle")
  providerTransactionId String?
  providerEventId       String?
  providerSignature     String?
  /**
   * EXPAND-PHASE COMPATIBILITY, kept readable for the previous release and filled
   * by a database trigger. Application code must not read or write these three;
   * the contract migration drops them.
   */
  paddleTransactionId   String?
  paddleEventId         String?
  paddleSignature       String?
  priceId               String?
  refundRequestId       String?
  refundReasonCode      String?
  requestedAt           DateTime  @default(now())
  processedAt           DateTime?

  purchase Purchase        @relation(fields: [purchaseId], references: [id])
  dispatch RefundDispatch?
}

// The outbound half of a refund: what FluxRadar asked the provider to do, and
// what it knows about the answer.
//
// RefundRecord is the decision — "this purchase is to be refunded, for this
// reason, in this amount" — and ProviderRefund is what actually came back
// through the webhook. Neither of them can say whether a submission was sent,
// which is the one fact that must not be guessed at: a refund is a money write
// on a provider API that has no idempotency key, so "did it go through?" cannot
// be answered by trying again.
//
// This row is therefore the record of the attempt itself, one per purchase
// (both unique columns say so), and its `state` is allowed to be honest about
// not knowing:
//
//   requested  — recorded, nothing sent. The default, and where the manual
//                policy leaves every refund.
//   submitting — a submission is in flight. Written BEFORE the request leaves,
//                so a crash mid-call is visible instead of invisible.
//   submitted  — the provider accepted it and named its own refund id.
//   settled    — the provider's own webhook later reported the money back.
//   manual     — an operator is handling it outside the API.
//   uncertain  — the call did not produce an answer we can act on (timeout,
//                5xx, unparseable body). It may or may not have refunded the
//                buyer. NOTHING retries this automatically.
//   failed     — the provider refused it outright, and said so. No money moved.
model RefundDispatch {
  id                 String    @id @default(cuid())
  refundRecordId     String    @unique
  /** One dispatch per purchase, mirroring the RefundRecord aggregate. */
  purchaseId         String    @unique
  provider           String
  /** Stable logical key for the submission: refund-dispatch:{purchaseId}. */
  idempotencyKey     String    @unique
  state              String
  stateReason        String?
  amountUsd          Float
  currency           String
  /** The provider's order identifier the return was requested against. */
  providerOrderId    String?
  /** The provider's own id for the return it created, once it stated one. */
  providerRefundId   String?
  /** The provider's reason code the submission carried, verbatim. */
  providerReasonCode String?
  /**
   * How many submissions were started. It exists to make a second attempt
   * VISIBLE, not to drive one: the dispatcher refuses to leave `submitting` or
   * `uncertain` on its own.
   */
  attempts           Int       @default(0)
  requestedAt        DateTime  @default(now())
  submittedAt        DateTime?
  settledAt          DateTime?
  /** Who resolved a `manual` or `uncertain` dispatch, for the audit trail. */
  resolvedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refundRecord RefundRecord @relation(fields: [refundRecordId], references: [id], onDelete: Cascade)

  /// The operator queue: "what is waiting to be sent, and what is stuck?"
  @@index([state, requestedAt])
}

// One refund the provider actually reported against a purchase (a FastSpring
// `return.created`).
//
// RefundRecord is the aggregate and §18 admits exactly one of those per purchase,
// so it cannot hold the individual returns: writing each one into it makes the
// second partial return overwrite the first, and the entitlement is then measured
// against a single return instead of everything that went back. These rows are the
// lines the aggregate sums. Keying them on the provider's own refund id is what
// makes the sum idempotent — the same return redelivered under a new webhook event
// id is counted exactly once.
//
// LEGACY HISTORY IS NOT RECONSTRUCTABLE. The migration that created this table
// backfills one line per FastSpring RefundRecord already marked 'paid'. That is
// everything the old data holds — RefundRecord is a single row per purchase and
// the pre-cumulative handler OVERWROTE it on every return, so a purchase refunded
// in instalments before the deploy kept only the last one. The backfill therefore
// restores the last recorded instalment, not the sum, and no query over the
// remaining data can tell the two apart. Inventing the missing lines would mean
// inventing money movements, so it is not attempted: the shortfall is documented
// in docs/FASTSPRING.md §7 as an operator reconciliation step against the
// FastSpring console, and it is bounded — it can only affect purchases that were
// already partially refunded before the deploy, and a later return still adds to
// whatever was backfilled.
model ProviderRefund {
  id               String   @id @default(cuid())
  purchaseId       String
  provider         String
  /**
   * The provider's own id for this refund (the FastSpring return id). A payload
   * that carries none falls back to the delivery's event id, which is unique per
   * delivery; `reason` then says so.
   */
  providerRefundId String
  /**
   * Event type that reported it, e.g. 'return.created'.
   */
  eventType        String
  /**
   * The refund on the purchase's charged basis: the same figure and currency as
   * `Purchase.settledAmount ?? Purchase.amountUsd`. The suspend decision sums this
   * column, so every line has to be stated on that one basis.
   */
  amountCharged    Float
  /**
   * The same refund, USD-normalised, as the RefundRecord aggregate states it.
   */
  amountUsd        Float
  /**
   * Currency `amountCharged` is stated in.
   */
  currency         String?
  /**
   * Why the figures are what they are, whenever the payload did not simply state them.
   */
  reason           String?
  createdAt        DateTime @default(now())

  // Cascade, not Prisma's RESTRICT default: the previous release does not know
  // this table, so after a rollback its account deletion removes purchases while
  // these rows still point at them (same reasoning as CheckoutSession above).
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  // The refund is counted once per purchase, whatever redelivers it.
  @@unique([purchaseId, providerRefundId])
}

// DB-backed job queue (D-005): worker claim is an atomic conditional update by scanId.
model Job {
  id         String    @id @default(cuid())
  scanId     String    @unique
  type       String
  status     String
  attempts   Int       @default(0)
  claimedAt  DateTime?
  leaseUntil DateTime?
  createdAt  DateTime  @default(now())

  scan Scan @relation(fields: [scanId], references: [id])

  /// The queue claim reads the oldest Pending job every 30 seconds and the
  /// recovery pass reads Claimed jobs whose lease expired. Job keeps one row per
  /// scan forever, so without this index both are a sequential scan that grows
  /// with the product's history rather than with the queue's depth.
  @@index([status, createdAt, id])
}
