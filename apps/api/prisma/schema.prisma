// FluxRadar v0.1 database schema (T-06, D-011: PostgreSQL for local, test, and production).
// Status columns are strings holding the canonical contract enum literals from
// @fluxradar/contracts; keeping the literals as text makes the export contract
// explicit and provider-independent (D-108).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                    String    @id @default(cuid())
  email                 String    @unique
  passwordHash          String
  emailVerifiedAt       DateTime?
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?
  // One-time anonymous-quality gate: the Free check is granted once per account.
  // The nullable timestamp is claimed atomically before the scan/job is created.
  freeCheckUsedAt       DateTime?
  createdAt             DateTime  @default(now())

  sessions           Session[]
  siteProfiles       SiteProfile[]
  purchases          Purchase[]
  checkoutSessions   CheckoutSession[]
  scans              Scan[]
  aiConsents         AiConsent[]
  integrations       IntegrationConnection[]
  googleBindings     SiteGoogleBinding[]
  reachabilityProbes SiteReachabilityProbe[]
  oauthStates        IntegrationOAuthState[]
  artifacts          ExportArtifact[]
  emailTokens        EmailToken[]
  emailNotifications EmailNotification[]
}

model EmailToken {
  id        String    @id @default(cuid())
  accountId String
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, kind])
  @@index([expiresAt])
}

model EmailNotification {
  id        String   @id @default(cuid())
  accountId String
  eventKey  String   @unique
  kind      String
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
}

// Global anti-abuse claim. It deliberately has no account relation so deleting
// an account does not make its domain eligible for another free check.
model FreeCheckClaim {
  origin    String   @id
  claimedAt DateTime @default(now())
}

// Content-free audit fact that survives account deletion (§17 retention).
model AccountDeletionAudit {
  id            String    @id @default(cuid())
  accountIdHash String    @unique
  status        String
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?
}

// Allows old signed evidence links to fail closed with 410 after retention.
model DeletedScan {
  id            String   @id @default(cuid())
  scanId        String   @unique
  accountIdHash String
  reason        String
  deletedAt     DateTime @default(now())
}

model Session {
  id        String   @id @default(cuid())
  accountId String
  tokenHash String   @unique
  expiresAt DateTime

  account Account @relation(fields: [accountId], references: [id])
}

model SiteProfile {
  id        String   @id @default(cuid())
  accountId String
  name      String
  domain    String
  industry  String?
  region    String?
  language  String?
  businessDescription String?
  offerings           String?
  targetLanguages     String?
  targetAudience      String?
  scanConfigJson      String    @default("{\"plan\":\"Complete\",\"scope\":{\"includeSubdomains\":false,\"maxPages\":15,\"maxDepth\":5,\"queryPolicy\":\"ignore\",\"respectRobots\":true,\"robotsOverrideConfirmed\":false,\"userAgent\":\"desktop\"}}")
  scanConfigVersion   Int       @default(1)
  createdAt DateTime @default(now())

  account          Account            @relation(fields: [accountId], references: [id])
  purchases        Purchase[]
  checkoutSessions CheckoutSession[]
  scans            Scan[]
  googleBinding    SiteGoogleBinding?
  reachabilityProbe SiteReachabilityProbe?

  // T-12: one profile per (account, domain) — a second profile for the same
  // origin would split scan history and break Resolved/Reopened comparison.
  @@unique([accountId, domain])
}

// Idempotency contract §18: (provider, providerTransactionId) admits exactly one
// purchase. The pair — not the id alone — is the key, so a FastSpring order id can
// never be mistaken for another provider's transaction id (and vice versa).
model Purchase {
  id                    String   @id @default(cuid())
  accountId             String
  siteProfileId         String
  plan                  String
  /**
   * Payment provider that produced this purchase: 'fastspring', or the name of a
   * retired provider on a historical row. Always set explicitly; there is no
   * default to fall back on.
   */
  provider              String
  /**
   * The provider's order id: a FastSpring order id.
   */
  providerTransactionId String
  /**
   * The provider's product: a FastSpring product path.
   */
  priceId               String?
  /**
   * USD-normalised price the refund policy works in.
   */
  amountUsd             Float
  currency              String
  /**
   * What the buyer was actually charged when FastSpring localised the currency.
   * Null when the charge was already in USD.
   */
  settledAmount         Float?
  settledCurrency       String?
  // Billing state: 'paid' | 'Refunded' | 'Disputed' (§18: billing overlay, not a scan state).
  status                String   @default("paid")
  createdAt             DateTime @default(now())

  account     Account          @relation(fields: [accountId], references: [id])
  siteProfile SiteProfile      @relation(fields: [siteProfileId], references: [id])
  entitlement Entitlement?
  scan        Scan?
  refund      RefundRecord?
  refundLines ProviderRefund[]
  checkout    CheckoutSession?

  @@unique([provider, providerTransactionId])
  /// Profile deletion counts the purchases that block it; the SiteProfile
  /// foreign key is checked on every profile write.
  @@index([siteProfileId])
}

// Server-side binding between a paid checkout and the account/profile it was
// started for. It is created BEFORE the provider session is opened and is the
// only source of truth for accountId/siteProfileId/plan/scope/AI consent — the
// browser and the provider payload never supply them. `reference` is the opaque
// value round-tripped through FastSpring order tags and item attributes.
model CheckoutSession {
  id                String    @id @default(cuid())
  provider          String
  reference         String    @unique
  accountId         String
  siteProfileId     String
  plan              String
  /**
   * Provider product identifier the session was opened with (FastSpring product path).
   */
  productPath       String
  /**
   * Catalogue price in USD at session time; kept for reconciliation.
   */
  expectedAmountUsd Float
  /**
   * Amount/currency FastSpring itself quoted for the session, when it returns one.
   */
  quotedAmount      Float?
  quotedCurrency    String?
  /**
   * True for a live-mode checkout, false for a provider test-mode checkout.
   */
  liveMode          Boolean
  providerSessionId String?
  /**
   * 'created' | 'completed' | 'rejected'.
   */
  status            String    @default("created")
  statusReason      String?
  /**
   * What the buyer was actually charged, echoed from the completed order.
   */
  settledAmount     Float?
  settledCurrency   String?
  scopeJson         String
  profileConfigVersion Int @default(1)
  executionConfigJson String?
  aiConsentJson     String?
  purchaseId        String?   @unique
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Cascade, not Prisma's RESTRICT default: the previous release does not know
  // this table, so its account deletion removes SiteProfile/Account without
  // clearing checkout sessions first. RESTRICT would make that deletion fail
  // after a rollback. The current release still deletes them explicitly.
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  siteProfile SiteProfile @relation(fields: [siteProfileId], references: [id], onDelete: Cascade)
  // The purchase outlives the session: keep the paid record when it is removed.
  purchase    Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([provider, providerSessionId])
  /// "Does this profile have a checkout that can still be paid?" — asked before
  /// a profile is deleted and before its domain may be changed.
  @@index([siteProfileId, status])
}

// Unique purchaseId: exactly one entitlement per purchase (§18 idempotency contract).
model Entitlement {
  id         String   @id @default(cuid())
  purchaseId String   @unique
  expiresAt  DateTime
  suspended  Boolean  @default(false)

  purchase Purchase @relation(fields: [purchaseId], references: [id])
}

// purchaseId is nullable-unique: the Free check runs without a purchase,
// every paid purchase owns exactly one scan (§18 idempotency contract).
model Scan {
  id                 String    @id @default(cuid())
  purchaseId         String?   @unique
  accountId          String
  siteProfileId      String
  plan               String
  domain             String
  status             String    @default("Pending")
  statusReason       String?
  scopeJson          String
  /// What the crawl of this scan achieved: how much of the site was read, and
  /// whether it was read at all (@fluxradar/contracts crawlSummarySchema).
  /// NULL on scans that ran before the column existed — "not recorded", which
  /// the report states rather than rendering as a measured zero.
  crawlSummaryJson   String?
  profileConfigVersion Int @default(1)
  executionConfigJson String?
  rulesetVersion     String
  platformRetryCount Int       @default(0)
  moduleRetryCount   Int       @default(0)
  /// Action Plan generations of this snapshot, across every language (D-232):
  /// attempts of any outcome and successes, capped at 6 and 3. A re-run resets
  /// both, because the plans they bought were written from issues it replaced.
  actionPlanAttempts Int       @default(0)
  actionPlanSuccesses Int      @default(0)
  /// The one generation in flight for this scan, claimed together with the
  /// counters in one conditional update. A run older than five minutes is
  /// presumed dead and may be taken over; its start time is also the token a
  /// finishing run must still hold to write its result.
  actionPlanRunStartedAt DateTime?
  actionPlanRunLanguage  String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())

  purchase    Purchase?          @relation(fields: [purchaseId], references: [id])
  account     Account            @relation(fields: [accountId], references: [id])
  siteProfile SiteProfile        @relation(fields: [siteProfileId], references: [id])
  modules     ScanModule[]
  issues      Issue[]
  aiResponses AiResponseRecord[]
  aiConsent   AiConsent?
  job         Job?
  artifacts   ExportArtifact[]
  actionPlans ActionPlan[]
  actionPlanLog ActionPlanAttempt[]

  /// Scan history is read one page at a time, newest first, for one account —
  /// with and without a site-profile filter. Both list endpoints order by
  /// (createdAt DESC, id DESC), so these two indexes are the ordering as much as
  /// the filter: PostgreSQL walks them backwards and stops at the page size
  /// instead of sorting every scan the account has ever run.
  @@index([accountId, createdAt, id])
  @@index([accountId, siteProfileId, createdAt, id])
  /// The Basic/Complete history gate asks "does this account (or this profile)
  /// own a scan of plan X" before every list page. It is an existence probe and
  /// must not have to read rows to answer it.
  @@index([accountId, plan])
  /// GET /scans/active: the one in-flight scan of an account.
  @@index([accountId, status])
  /// Profile deletion counts the scans that block it, and the SiteProfile
  /// foreign key is checked on every profile write.
  @@index([siteProfileId])
}

model ScanModule {
  id                        String  @id @default(cuid())
  scanId                    String
  module                    String
  runtimeStatus             String
  exportStatus              String?
  statusReason              String?
  coverage                  Float?
  score                     Float?
  applicableChecks          Int?
  completedApplicableChecks Int?
  metadataJson              String  @default("{}")
  // §18 usable output: >=1 completed applicable check AND a valid metric/score/
  // finding with evidence (computed via @fluxradar/scoring hasUsableOutput, D-026).
  usableOutput              Boolean @default(false)

  scan Scan @relation(fields: [scanId], references: [id])

  @@unique([scanId, module])
}

model Issue {
  id                  String   @id @default(cuid())
  scanId              String
  ruleId              String
  module              String
  fingerprint         String
  severity            String
  /// Urgency order of `severity` (0 Critical … 3 Low, 4 unknown). Text sorts
  /// alphabetically and put Low above Medium; lists order by this instead.
  severityRank        Int      @default(4)
  category            String
  status              String
  targetKind          String
  normalizedUrl       String
  normalizedResource  String
  normalizedSelector  String
  normalizedParameter String
  ruleVariant         String
  targetUrl           String
  evidenceType        String
  evidenceRef         String?
  evidenceExcerpt     String?
  // Non-scoring cross-module evidence link (§14 cross-module policy, D-167).
  evidenceGroupId     String?
  recommendation      String
  // Message codes and values behind evidenceExcerpt/recommendation, rendered per
  // report language. NULL for findings that predate codes or carry AI-written text.
  messagesJson        String?
  confidence          Float
  applicableTargets   Int
  affectedTargets     Int
  rulePenalty         Float
  scoreDelta          Float
  observedAt          DateTime

  scan Scan @relation(fields: [scanId], references: [id])

  @@index([scanId, fingerprint])
  @@index([scanId, severityRank, fingerprint])
  @@index([fingerprint])
}

// Normalized provider response (§5/§16); aiRequestKey is the deterministic
// idempotency key ai:{scan_id}:{provider}:{prompt_hash}:{sequence} (D-015).
model AiResponseRecord {
  id                  String   @id @default(cuid())
  scanId              String
  module              String   @default("AI SEO / GEO")
  promptText          String   @default("")
  tokenizerVersion    String?
  provider            String
  apiVersion          String
  modelId             String
  promptVersion       String
  requestId           String
  requestIdSource     String
  aiRequestKey        String   @unique
  usageJson           String
  usageSource         String
  rawText             String
  citationsJson       String
  finishReason        String
  deletionEvidenceRef String?
  createdAt           DateTime @default(now())

  scan Scan @relation(fields: [scanId], references: [id])
}

/// An AI-written Action Plan for one scan in one language (D-232). Only a ready
/// plan is stored, so a regeneration that is running or failed never hides or
/// loses the current one; a new plan in a language replaces the old one.
///
/// Its own table rather than AiResponseRecord, which is part of the CSV export
/// contract: the plan is an AI opinion, not a canonical record, and no export
/// carries it. The text is a snapshot; issue counts are read live beside it.
///
/// CASCADE, not RESTRICT: after a rollback the previous release deletes scans
/// without knowing this table (BILLING-007). This release still deletes these
/// rows itself, before the scan.
model ActionPlan {
  id            String   @id @default(cuid())
  scanId        String
  language      String
  /// { overview, actions: [{ title, why, steps, effort, ruleIds }] }
  contentJson   String
  /// The exact redacted text sent to the provider.
  promptText    String
  promptVersion String
  /// The model that served the answer, which a refusal fallback may change.
  modelId       String
  requestId     String
  usageJson     String
  /// The notice shown under the button the owner clicked; the click is the consent.
  noticeVersion String
  generatedAt   DateTime

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, language])
}

/// The Action Plan spend log: one row per generation attempt, whatever came of
/// it (D-232). The product-wide daily cap counts these rows; a failed row keeps
/// a failure code, never provider text. A re-run of the scan keeps them.
model ActionPlanAttempt {
  id          String    @id @default(cuid())
  scanId      String
  accountId   String
  language    String
  /// Running | Succeeded | Failed
  status      String
  failureCode String?
  /// Present once a provider answered: an unusable answer still cost tokens.
  usageJson   String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  /// The daily cap counts every attempt of the last 24 hours.
  @@index([createdAt])
  @@index([scanId])
}

model AiConsent {
  id            String   @id @default(cuid())
  accountId     String
  scanId        String   @unique
  providersJson String
  noticeVersion String
  createdAt     DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
  scan    Scan    @relation(fields: [scanId], references: [id])
}

// User-authorized external data sources. Access and refresh tokens are always
// encrypted before persistence; metadata contains only provider resource IDs
// and selected settings, never raw credentials.
model IntegrationConnection {
  id                    String    @id @default(cuid())
  accountId             String
  provider              String
  status                String    @default("connected")
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  tokenExpiresAt        DateTime?
  scopesJson            String    @default("[]")
  metadataJson          String    @default("{}")
  lastCheckedAt         DateTime?
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@unique([accountId, provider])
  @@index([accountId, status])
}

// Which Google properties an account chose for one of its site profiles. Only
// provider resource identifiers are stored here — never tokens, never metrics.
// One binding per site profile keeps a report's data source unambiguous.
model SiteGoogleBinding {
  id                   String   @id @default(cuid())
  accountId            String
  siteProfileId        String   @unique
  /**
   * Search Console property, e.g. "sc-domain:example.com" or "https://example.com/".
   */
  searchConsoleSiteUrl String?
  /**
   * Bare GA4 numeric property id, without the "properties/" prefix.
   */
  ga4PropertyId        String?
  /**
   * Display name captured at selection time so the report can name the source.
   */
  ga4PropertyName      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  account     Account     @relation(fields: [accountId], references: [id])
  siteProfile SiteProfile @relation(fields: [siteProfileId], references: [id])

  @@index([accountId])
}

// The last time we asked a site whether it will let our crawler read it, and
// what it answered. One row per profile: only the freshest answer matters, and
// keeping a history of refusals would be a log, not a precondition.
//
// This exists so a purchase can be refused before it happens. `createCheckoutSession`
// requires a row here that is recent and says `reachable`; the browser's word is
// not evidence, so the server re-reads this rather than trusting a request field.
model SiteReachabilityProbe {
  id            String   @id @default(cuid())
  accountId     String
  siteProfileId String   @unique
  /**
   * The origin actually probed, as the profile's domain read at the time.
   * Compared with the profile's current domain before a purchase is allowed:
   * without it the row says only "this profile was reachable", and a domain
   * changed after a passing probe would sell a scan of an unchecked site.
   * NULL on rows written before the column existed — treated as unusable.
   */
  origin        String?
  /**
   * The egress location the probe left from (D-228), or NULL for a direct
   * probe. A site can let Kyiv in and refuse Frankfurt, so a probe answers for
   * the location it used and nothing else: the checkout requires it to match
   * the location being bought. A row written before the column existed reads
   * as NULL, which matches only a deployment that crawls directly.
   */
  egressLocation String?
  /**
   * One of the crawler's own reach verdicts: 'reachable' | 'access-denied' |
   * 'blocked-by-robots' | 'unreachable' | 'bad-response'. Produced by
   * @fluxradar/crawler assessSiteReach, so the probe and the scan cannot
   * disagree about what the same response means.
   */
  state         String
  /** Start page status, or null when no response arrived at all. */
  startStatus   Int?
  /** safe-fetch's reason when nothing came back; null when something did. */
  fetchError    String?
  /** `server: cloudflare` and the other vendor headers, as a JSON array. */
  signalsJson   String   @default("[]")
  checkedAt     DateTime
  createdAt     DateTime @default(now())

  account     Account     @relation(fields: [accountId], references: [id])
  siteProfile SiteProfile @relation(fields: [siteProfileId], references: [id])

  @@index([accountId])
}

// SUPERSEDED by CrawlEgressLocationUsage (D-228), and kept only because the
// previous release still reads and writes it: dropping it is a contract-phase
// migration for when no release with a single proxy can come back. Nothing in
// this release writes here.
//
// How much of the egress proxy's monthly traffic allowance the crawl has spent.
// One row per calendar month (UTC), incremented in the database so two scans
// finishing together cannot lose each other's bytes.
model CrawlEgressUsage {
  /// `YYYY-MM` in UTC — the unit the hosting plan resets on.
  month     String   @id
  /// Page and media bodies read through the proxy. A floor, not a bill:
  /// headers, TLS and retries are not in it, and vnstat on the VPS remains
  /// the authority. The threshold is set low enough that the gap is covered.
  bytes     BigInt   @default(0)
  updatedAt DateTime @updatedAt
}

// How much of each egress proxy's monthly traffic allowance the crawl has spent.
//
// Every egress location is its own VPS on its own plan (D-228), so traffic is
// counted per location and per calendar month (UTC), incremented in the
// database so two scans finishing together cannot lose each other's bytes.
model CrawlEgressLocationUsage {
  /// The egress location's registry id (`ua`, `de-fra`).
  location  String
  /// `YYYY-MM` in UTC — the unit the hosting plan resets on.
  month     String
  /// Page and media bodies read through the proxy. A floor, not a bill:
  /// headers, TLS and retries are not in it, and vnstat on the VPS remains
  /// the authority. The threshold is set low enough that the gap is covered.
  bytes     BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@id([location, month])
}

// One-time OAuth state prevents callback CSRF and replay. Only a SHA-256 hash
// of the state value is stored; the raw value exists in the browser redirect.
model IntegrationOAuthState {
  id        String    @id @default(cuid())
  accountId String
  provider  String
  stateHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, provider])
  @@index([expiresAt])
}

// Private report artifact stored in Hetzner Object Storage. The DB row keeps
// the object address and tenant boundary; the object itself is never public.
model ExportArtifact {
  id          String   @id @default(cuid())
  accountId   String
  scanId      String
  format      String
  objectKey   String
  contentType String
  createdAt   DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id])
  scan    Scan    @relation(fields: [scanId], references: [id])

  @@unique([scanId, format])
  @@index([accountId, createdAt])
}

// Dedup table for provider webhook events: unique (provider, providerEventId)
// makes redelivery a no-op (§18). FastSpring reuses the event id on automatic
// retries, so the pair is the idempotency key. Raw payload + signature are
// retained per D-029.
model WebhookEvent {
  id                    String   @id @default(cuid())
  provider              String
  providerEventId       String
  accountId             String?
  providerTransactionId String?
  eventType             String
  /**
   * 'processed' | 'deduplicated' | 'ignored' | 'rejected' | 'unlinked' — why the
   * event did or did not act. The default keeps the previous release's inserts,
   * which only ever stored processed events, meaningful.
   */
  outcome               String   @default("processed")
  outcomeReason         String?
  rawBody               String
  signature             String
  processedAt           DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([accountId])
  @@index([providerTransactionId])
  /// The pending-refund sweep's access path: it walks the `unlinked` rows of one
  /// provider in delivery order every five minutes. Without this index that walk
  /// is a sequential scan of every webhook delivery ever received, which grows
  /// with sales volume while the pending rows it is looking for do not.
  @@index([provider, outcome, processedAt])
}

// Unique purchaseId AND unique idempotencyKey (refund:{purchase_id}): a second
// refund is impossible regardless of reason code (§18 idempotency contract).
model RefundRecord {
  id                    String    @id @default(cuid())
  purchaseId            String    @unique
  idempotencyKey        String    @unique
  reasonCode            String
  // 'requested' | 'processing' | 'paid' | 'failed' (§18).
  status                String
  amountUsd             Float
  currency              String?
  taxAmountUsd          Float?
  provider              String
  providerTransactionId String?
  providerEventId       String?
  providerSignature     String?
  priceId               String?
  refundRequestId       String?
  refundReasonCode      String?
  requestedAt           DateTime  @default(now())
  processedAt           DateTime?

  purchase Purchase @relation(fields: [purchaseId], references: [id])
}

// One refund the provider actually reported against a purchase (a FastSpring
// `return.created`).
//
// RefundRecord is the aggregate and §18 admits exactly one of those per purchase,
// so it cannot hold the individual returns: writing each one into it makes the
// second partial return overwrite the first, and the entitlement is then measured
// against a single return instead of everything that went back. These rows are the
// lines the aggregate sums. Keying them on the provider's own refund id is what
// makes the sum idempotent — the same return redelivered under a new webhook event
// id is counted exactly once.
//
// LEGACY HISTORY IS NOT RECONSTRUCTABLE. The migration that created this table
// backfills one line per FastSpring RefundRecord already marked 'paid'. That is
// everything the old data holds — RefundRecord is a single row per purchase and
// the pre-cumulative handler OVERWROTE it on every return, so a purchase refunded
// in instalments before the deploy kept only the last one. The backfill therefore
// restores the last recorded instalment, not the sum, and no query over the
// remaining data can tell the two apart. Inventing the missing lines would mean
// inventing money movements, so it is not attempted: the shortfall is documented
// in docs/FASTSPRING.md §7 as an operator reconciliation step against the
// FastSpring console, and it is bounded — it can only affect purchases that were
// already partially refunded before the deploy, and a later return still adds to
// whatever was backfilled.
model ProviderRefund {
  id               String   @id @default(cuid())
  purchaseId       String
  provider         String
  /**
   * The provider's own id for this refund (the FastSpring return id). A payload
   * that carries none falls back to the delivery's event id, which is unique per
   * delivery; `reason` then says so.
   */
  providerRefundId String
  /**
   * Event type that reported it, e.g. 'return.created'.
   */
  eventType        String
  /**
   * The refund on the purchase's charged basis: the same figure and currency as
   * `Purchase.settledAmount ?? Purchase.amountUsd`. The suspend decision sums this
   * column, so every line has to be stated on that one basis.
   */
  amountCharged    Float
  /**
   * The same refund, USD-normalised, as the RefundRecord aggregate states it.
   */
  amountUsd        Float
  /**
   * Currency `amountCharged` is stated in.
   */
  currency         String?
  /**
   * Why the figures are what they are, whenever the payload did not simply state them.
   */
  reason           String?
  createdAt        DateTime @default(now())

  // Cascade, not Prisma's RESTRICT default: the previous release does not know
  // this table, so after a rollback its account deletion removes purchases while
  // these rows still point at them (same reasoning as CheckoutSession above).
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  // The refund is counted once per purchase, whatever redelivers it.
  @@unique([purchaseId, providerRefundId])
}

// DB-backed job queue (D-005): worker claim is an atomic conditional update by scanId.
model Job {
  id         String    @id @default(cuid())
  scanId     String    @unique
  type       String
  status     String
  attempts   Int       @default(0)
  claimedAt  DateTime?
  leaseUntil DateTime?
  createdAt  DateTime  @default(now())

  scan Scan @relation(fields: [scanId], references: [id])

  /// The queue claim reads the oldest Pending job every 30 seconds and the
  /// recovery pass reads Claimed jobs whose lease expired. Job keeps one row per
  /// scan forever, so without this index both are a sequential scan that grows
  /// with the product's history rather than with the queue's depth.
  @@index([status, createdAt, id])
}
