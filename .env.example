DATABASE_URL=postgresql://fluxradar:replace-with-a-local-password@localhost:5432/fluxradar
TEST_DATABASE_URL=postgresql://fluxradar:replace-with-a-local-password@localhost:5432/fluxradar_test
POSTGRES_DB=fluxradar
POSTGRES_USER=fluxradar
POSTGRES_PASSWORD=replace-with-a-local-password
FLUXRADAR_ENV_FILE=.env
SESSION_SECRET=replace-with-a-long-local-secret
PADDLE_WEBHOOK_SECRET=replace-with-a-local-webhook-secret
PORT=3310
FRONTEND_ORIGIN=http://localhost:5174

# Exact, comma-separated emails allowed to run Basic/Complete scans internally
# without a payment. Keep this empty for normal environments.
FLUXRADAR_INTERNAL_FREE_EMAILS=

# User-authorized analytics integrations. Leave blank until OAuth clients exist.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3310/integrations/google/callback
BING_OAUTH_CLIENT_ID=
BING_OAUTH_CLIENT_SECRET=
BING_OAUTH_REDIRECT_URI=http://localhost:3310/integrations/bing/callback

# Server-side AI and performance data providers.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_API_VERSION=2023-06-01
PAGESPEED_API_KEY=
CRUX_API_KEY=

# Hetzner Object Storage (S3-compatible), used by FluxRadar for reports/evidence.
HETZNER_S3_ENDPOINT=
HETZNER_S3_REGION=
HETZNER_S3_BUCKET=
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=

# Transactional email. Production requires a verified Resend sender/domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Dedicated key for encrypting user integration tokens. It is required in
# production; local development/tests may intentionally fall back to SESSION_SECRET.
INTEGRATION_ENCRYPTION_KEY=
