# Local development environment. The production file is assembled by the deploy
# workflow from the PRODUCTION_ENV_FILE secret plus the optional per-integration
# secrets, and is normalized by deploy/normalize-env-file.cjs: plain KEY=value
# lines only, no quotes, no "$" in values docker compose reads, no inline "#"
# comment on a value line. See docs/DEPLOYMENT.md.

DATABASE_URL=postgresql://fluxradar:replace-with-a-local-password@localhost:5432/fluxradar
TEST_DATABASE_URL=postgresql://fluxradar:replace-with-a-local-password@localhost:5432/fluxradar_test
POSTGRES_DB=fluxradar
POSTGRES_USER=fluxradar
POSTGRES_PASSWORD=replace-with-a-local-password
FLUXRADAR_ENV_FILE=.env
SESSION_SECRET=replace-with-a-long-local-secret
PORT=3310
FRONTEND_ORIGIN=http://localhost:5174

# Exact, comma-separated emails allowed to run Basic/Complete scans without a
# payment (POST /billing/internal-checkout). This is the ONLY way to a paid plan
# without paying, in every environment. On a deployment real buyers use, list
# named internal accounts only — every address here scans for free. Locally,
# list the account you develop with: FastSpring cannot complete a checkout from
# localhost, so this is how a Basic/Complete scan is run there (README.md,
# "Paid scans locally"). Unset or empty means nobody; NODE_ENV is not read.
FLUXRADAR_INTERNAL_FREE_EMAILS=

# Exact, comma-separated https ORIGINS that may run the free homepage check as
# often as they like — the demo site, the marketing site, a customer site being
# reproduced during support. A listed origin skips BOTH free-check limits: the
# account's one-time flag is not spent and no global per-domain claim is written,
# so any account can re-check it. Matching is exact on the normalized origin and
# there are no wildcards: https://example.com does not cover
# https://www.example.com. An entry that is not an https origin is ignored and
# named in the startup log. Leave it empty to keep the one-time limit everywhere.
#
# In production it has a deploy override: the `production` VARIABLE (not secret —
# an https origin is public by construction) PRODUCTION_FREE_CHECK_ALLOWED_ORIGINS
# replaces this when non-empty, so the list can be corrected without rewriting the
# whole base env file. See docs/DEPLOYMENT.md, "Free-check allowlist".
FLUXRADAR_FREE_CHECK_ALLOWED_ORIGINS=

# How many reverse-proxy hops sit in front of the API, which is what decides the
# client address every IP-scoped rate limit counts against. Production runs
# behind one Caddy, so TRUST_PROXY=1 there; a process exposed directly must use
# "false" (or 0), otherwise a client can forge X-Forwarded-For and take a fresh
# rate-limit bucket per request. Unset keeps the old behaviour: one hop when
# NODE_ENV=production, none elsewhere. A blanket "true" is rejected on purpose.
TRUST_PROXY=false

# --- FastSpring (paid checkout) ----------------------------------------------
# Every line below is commented out on purpose: with no FASTSPRING_ variable set
# at all, paid checkout is simply off, the API still boots, and the UI shows a
# setup state. Uncommenting only SOME of them is a fatal configuration error in
# production (fail closed). See docs/FASTSPRING.md.
#
# "test" while validating with FastSpring test orders, "live" for real payments.
#FASTSPRING_MODE=test
# Developer Tools > APIs > API Credentials in the FastSpring app.
#FASTSPRING_API_USERNAME=
#FASTSPRING_API_PASSWORD=
# The HMAC key configured on the webhook in the FastSpring app (X-FS-Signature).
#FASTSPRING_WEBHOOK_SECRET=
# "v1" = POST /sessions + classic storefront (needs FASTSPRING_STOREFRONT_URL).
# "v2" = POST /v2/checkouts/{path}/sessions (needs FASTSPRING_CHECKOUT_PATH).
#FASTSPRING_SESSION_API=v1
# v1 only: storefront origin, e.g. https://fluxradar.onfastspring.com
# (test mode is usually https://fluxradar.test.onfastspring.com).
#FASTSPRING_STOREFRONT_URL=
# v2 only: the checkout path configured in the FastSpring app.
#FASTSPRING_CHECKOUT_PATH=
# v2 only, REQUIRED: the popup checkout the browser opens, exactly as printed in
# Checkouts > Popup Checkouts > "Place on your Website" (the data-storefront
# value), with no https:// prefix — e.g. fluxradar.test.onfastspring.com/popup.
# It must match FASTSPRING_MODE: the ".test." host for test, the plain host for
# live. The API refuses to boot on a mismatch, because a session created in one
# mode can never be paid on the other mode's storefront.
#FASTSPRING_POPUP_STOREFRONT=
# One-time product paths, one per paid plan.
#FASTSPRING_PRODUCT_PATH_BASIC=
#FASTSPRING_PRODUCT_PATH_COMPLETE=
# How an order charged in a currency other than the session quote is treated.
# "strict"    - only the quoted currency is accepted. Correct ONLY when the
#               storefront cannot change currency; otherwise a buyer who was
#               charged in their own currency pays and gets nothing.
# "localized" - FastSpring may localise the currency; the order stays bound to
#               our session and product and the amount is checked against the
#               USD payout figure when FastSpring reports one.
#FASTSPRING_CURRENCY_POLICY=strict
# REQUIRED for FASTSPRING_MODE=live, and nothing else unlocks it. Set it to the
# literal "verified" only after checking, in the FastSpring app, that order tags
# reach the webhook and that the storefront currency behaviour matches
# FASTSPRING_CURRENCY_POLICY (docs/FASTSPRING.md section 4).
#FASTSPRING_STORE_VERIFIED=
# Optional: API base override (tests only) and buyer link lifetime in days (1-7).
# The lifetime is also the deadline a pending checkout row carries until
# FastSpring reports its own; past it the checkout no longer blocks the profile.
#FASTSPRING_API_BASE_URL=https://api.fastspring.com
#FASTSPRING_SESSION_EXPIRATION_DAYS=1

# User-authorized analytics integrations. Leave the whole block blank until the
# OAuth clients exist: with no variable set the integration is simply off.
# Setting only SOME of them is a fatal configuration error in production, and so
# is a production callback that is not an https:// URL on fluxradar.net ending in
# /integrations/<provider>/callback. The localhost callbacks below are a
# development convenience and are applied automatically when NODE_ENV is not
# "production" — production must state its own.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3310/integrations/google/callback
BING_OAUTH_CLIENT_ID=
BING_OAUTH_CLIENT_SECRET=
BING_OAUTH_REDIRECT_URI=http://localhost:3310/integrations/bing/callback

# Server-side AI and performance data providers. ANTHROPIC_MODEL is optional: the
# API falls back to DEFAULT_ANTHROPIC_MODEL (apps/api/src/integrations/
# anthropic-config.ts). In production a retired model identifier fails the boot
# while an API key is present, instead of failing every scan silently.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_VERSION=2023-06-01
# PageSpeed Insights works without a key; this key only raises the provider quota.
PAGESPEED_API_KEY=
# Optional CrUX field data provider; leave blank when CrUX is not enabled.
CRUX_API_KEY=

# The networks the crawl can leave from — one proxy per country the owner can
# choose on the launch screen (D-228), each as http://user:password@host:port
# (the port is required). CRAWL_EGRESS_PROXY_URL is Ukraine (Kyiv), the default
# location; another country is CRAWL_EGRESS_PROXY_URL_<CODE> (for example
# CRAWL_EGRESS_PROXY_URL_DE) plus its entry in
# apps/api/src/integrations/crawl-egress-locations.ts. All blank means the crawl
# goes out directly from this server, which is the local default. Production
# sets them because sites that block this server's hosting network answer 403
# to every request, and that reads in a report as a site with no robots.txt
# that never returns 200. A value that is set but unreadable — or a
# CRAWL_EGRESS_PROXY_URL_<CODE> with no registry entry — fails the boot by name
# rather than silently dropping a country or falling back to the direct,
# blocked route (apps/api/src/integrations/crawl-egress-config.ts).
CRAWL_EGRESS_PROXY_URL=
# CRAWL_EGRESS_PROXY_URL_DE=
# Optional: the address the internet should see through each proxy. The
# health check (every 5 minutes and before each scan) then also catches a
# proxy that answers but quietly leaves from somewhere else. Same naming:
# CRAWL_EGRESS_EXPECTED_IP is Ukraine's, CRAWL_EGRESS_EXPECTED_IP_<CODE> the rest.
CRAWL_EGRESS_EXPECTED_IP=
# CRAWL_EGRESS_EXPECTED_IP_DE=
# Optional: the endpoint every location's health check asks "what is my
# address?". Blank uses https://www.cloudflare.com/cdn-cgi/trace.
CRAWL_EGRESS_PROBE_URL=

# Hetzner Object Storage (S3-compatible), used by FluxRadar for reports/evidence.
# All five or none: a partial set is a fatal configuration error in production,
# because report archiving would otherwise be off while the deploy looks healthy.
HETZNER_S3_ENDPOINT=
HETZNER_S3_REGION=
HETZNER_S3_BUCKET=
HETZNER_S3_ACCESS_KEY=
HETZNER_S3_SECRET_KEY=

# --- Database backups (deploy/backup) ----------------------------------------
# Production only; a developer checkout needs none of this. The backup scripts
# reuse the HETZNER_S3_* bucket above and encrypt every dump before it is
# uploaded, so the key below is what stands between a leaked S3 credential and
# every customer record. Generate it once, store it in the password manager AND
# in the GitHub secret PRODUCTION_BACKUP_ENCRYPTION_KEY, and never rotate it
# without keeping the old key: snapshots taken with it stay unreadable otherwise.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
FLUXRADAR_BACKUP_ENCRYPTION_KEY=
# Where snapshots live in the bucket, and how long they are kept. All optional;
# the defaults are prefix=fluxradar/postgres, 30 days, at least 7 snapshots, at
# most 50 deletions per sweep, and no pruning at all once the newest snapshot is
# more than 48 hours old (failing backups must not also lose history).
FLUXRADAR_BACKUP_PREFIX=
FLUXRADAR_BACKUP_RETENTION_DAYS=
FLUXRADAR_BACKUP_MIN_KEEP=
FLUXRADAR_BACKUP_MAX_DELETE=
FLUXRADAR_BACKUP_STALE_HOURS=
# How old the newest snapshot may be before the nightly verification calls the
# backups broken (default 26 hours: one daily cycle plus slack). This is the
# alarm, not the retention refusal above — a snapshot from two weeks ago still
# decrypts and still restores, so nothing except its age says the backups have
# stopped. Keep it below FLUXRADAR_BACKUP_STALE_HOURS.
FLUXRADAR_BACKUP_MAX_AGE_HOURS=

# Transactional email (Resend). Optional until connected: the API boots in
# production without these, and email-dependent flows stay safely disabled and
# report a "not-configured" status instead of pretending a message was sent.
# Set BOTH the API key and the sender to enable email; setting only one is
# reported as a half-configured integration at startup, by name.
#
# RESEND_FROM_EMAIL must be an address ("mail@example.com" or
# "FluxRadar <mail@example.com>") on a domain VERIFIED in the Resend dashboard,
# with the DKIM/SPF records Resend prints published in DNS. Nothing in this
# repository can check that — an unverified domain is an HTTP error on the first
# send, which reaches the user as an emailVerification status of
# "provider-error". See docs/DEPLOYMENT.md, "Transactional email".
#
# In production both have a deploy override: the `production` secrets
# PRODUCTION_RESEND_API_KEY and PRODUCTION_RESEND_FROM_EMAIL replace these when
# non-empty, so a rotated key or a new sending subdomain does not mean rewriting
# the whole base env file. RESEND_REPLY_TO has no override — on its own it
# configures nothing. See docs/DEPLOYMENT.md, "Optional integration secrets".
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Support requests (Telegram). The floating "Support" form on every page posts
# to this bot, which writes each request into the support channel. Optional:
# with both empty, production offers no form at all, and local development
# writes each request to the API log instead of sending it. Set BOTH to connect
# it; setting only one is reported as a half-configured integration at startup,
# by name.
#
# TELEGRAM_BOT_TOKEN is the token @BotFather issues; the bot must be an
# administrator of the channel, allowed to post messages.
# TELEGRAM_SUPPORT_CHAT_ID is the channel's numeric id (a private channel's
# starts with -100) or a public channel's @username. See docs/DEPLOYMENT.md,
# "Support requests".
TELEGRAM_BOT_TOKEN=
TELEGRAM_SUPPORT_CHAT_ID=

# Dedicated key for encrypting user integration tokens (Google/Bing OAuth access
# and refresh tokens) at rest.
#
# REQUIRED in production, with no fallback, and it must NOT be the same value as
# SESSION_SECRET — the two protect different things and have to rotate
# independently, and reusing one makes every stored token undecryptable the day
# the other changes. The production boot refuses both mistakes by name, and the
# deploy refuses to ship an env file that makes them.
#
# Local development and tests may intentionally fall back to SESSION_SECRET, so
# leaving this empty in a checkout is fine. Generate a production key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotating it makes every EXISTING integration connection undecryptable, so users
# reconnect Google/Bing afterwards.
INTEGRATION_ENCRYPTION_KEY=
